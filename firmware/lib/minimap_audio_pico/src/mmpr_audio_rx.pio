.program mmpr_pico_i2s_in
.side_set 2

; Stereo I2S input with the standard one-bit LRCLK->MSB delay.
; The host initializes Y = slot_bits - 2 and primes the shifter with two
; EXEC'd IN instructions to align the first real left/right slot words.

.wrap_target
    mov x, y         side 0b00
left_channel:
    in pins, 1       side 0b01
    jmp x--, left_channel side 0b00
    in pins, 1       side 0b01
    mov x, y         side 0b10
right_channel:
    in pins, 1       side 0b11
    jmp x--, right_channel side 0b10
    in pins, 1       side 0b11
.wrap


.program mmpr_pico_i2s_in_falling
.side_set 2

; Stereo I2S input with the same LRCLK framing as above, but sampled on the
; opposite BCLK half-cycle. This lets the firmware choose the edge that matches
; the board-level data path without changing the PCM decode path.

.wrap_target
    mov x, y         side 0b01
left_channel:
    in pins, 1       side 0b00
    jmp x--, left_channel side 0b01
    in pins, 1       side 0b00
    mov x, y         side 0b11
right_channel:
    in pins, 1       side 0b10
    jmp x--, right_channel side 0b11
    in pins, 1       side 0b10
.wrap


.program mmpr_sirith_tdm_in
.side_set 2

; Four-slot TDM input for the ADAU7112 positive-pulse frame sync format.
; Input-only capture needs its own cadence: removing the upstream TDM in/out
; driver's data-out instruction would otherwise stretch FSYNC into a pulse
; every bit instead of a single frame-start pulse. The host initializes
; Y = (slot_bits * channels) - 1. FSYNC stays high for exactly the first BCLK
; period of the frame and low for the remaining slots. This variant samples on
; the BCLK high half-cycle (rising-side sampling).

.wrap_target
    mov x, y         side 0b10
    in pins, 1       side 0b11
    jmp x--, bitloop side 0b00
bitloop:
    in pins, 1       side 0b01
    jmp x--, bitloop side 0b00
.wrap


.program mmpr_sirith_tdm_in_falling
.side_set 2

; Same single-pulse frame timing as mmpr_sirith_tdm_in, but samples on the
; BCLK low half-cycle (falling-side sampling) so firmware can try the
; alternate capture phase if the board-level data path requires it.

.wrap_target
    mov x, y         side 0b11
    in pins, 1       side 0b10
    jmp x--, bitloop side 0b01
bitloop:
    in pins, 1       side 0b00
    jmp x--, bitloop side 0b01
.wrap
