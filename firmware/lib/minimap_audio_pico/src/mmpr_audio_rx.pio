.program mmpr_pico_i2s_in
.side_set 2

; Stereo I2S input with the standard one-bit LRCLK->MSB delay.
; The host initializes Y = slot_bits - 2 and primes the shifter with two
; EXEC'd IN instructions to align the first real left/right slot words.

.wrap_target
    mov x, y         side 0b00
left_channel:
    in pins, 1       side 0b01
    jmp x--, left_channel side 0b00
    in pins, 1       side 0b01
    mov x, y         side 0b10
right_channel:
    in pins, 1       side 0b11
    jmp x--, right_channel side 0b10
    in pins, 1       side 0b11
.wrap


.program mmpr_pico_i2s_in_falling
.side_set 2

; Stereo I2S input with the same LRCLK framing as above, but sampled on the
; opposite BCLK half-cycle. This lets the firmware choose the edge that matches
; the board-level data path without changing the PCM decode path.

.wrap_target
    mov x, y         side 0b01
left_channel:
    in pins, 1       side 0b00
    jmp x--, left_channel side 0b01
    in pins, 1       side 0b00
    mov x, y         side 0b11
right_channel:
    in pins, 1       side 0b10
    jmp x--, right_channel side 0b11
    in pins, 1       side 0b10
.wrap


.program mmpr_sirith_tdm_in
.side_set 2

; Four-slot TDM input for the ADAU7112 positive-pulse frame sync format.
; This mirrors the timing cadence used by Arduino Pico's pio_tdm_inout: one
; low half-cycle to launch/sample data, then one high half-cycle to complete
; the BCLK period. The host initializes Y = (slot_bits * channels) - 2.
; FSYNC is asserted for the first slot boundary and remains low for the rest of
; the frame. Autopush at 32 bits yields one FIFO word per slot.

.wrap_target
    mov x, y         side 0b01 [1]
bitloop:
    nop              side 0b00
    in pins, 1       side 0b00
    jmp x--, bitloop side 0b11 [1]
lastbit:
    in pins, 1       side 0b10
    nop              side 0b10
.wrap


.program mmpr_sirith_tdm_in_falling
.side_set 2

; Same frame timing as mmpr_sirith_tdm_in, but samples on the opposite half-
; cycle so the firmware can try the alternate data-capture phase if needed.

.wrap_target
    mov x, y         side 0b10 [1]
bitloop:
    in pins, 1       side 0b11
    nop              side 0b11
    jmp x--, bitloop side 0b00 [1]
lastbit:
    nop              side 0b01
    in pins, 1       side 0b01
.wrap
